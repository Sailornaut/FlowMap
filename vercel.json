{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/workflow",
      "destination": "/index.html"
    },
    {
      "source": "/workflow/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|workflow/).*)",
      "destination": "/app.html"
    }
  ]
}
